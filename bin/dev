#!/usr/bin/env bash
# Opens (or attaches to) a per-project tmux session with a fixed 4-window
# layout:  1: nvim   2: claude   3: shell   4: lazygit
# Session name = the project directory's basename, so each project gets its
# own independent session (running `dev` in different projects no longer
# joins the same session).
#
# Usage: dev [--no-attach] [directory]
#   - directory given: use it directly
#   - no directory, cwd is already a git repo: use cwd
#   - no directory, cwd isn't a project: fuzzy-pick one from ~/Git via fzf
#   - --no-attach: create/ensure the session exists but don't attach to it
#     (used by nvim's "Dev Setup" dashboard action, which switches the
#     client itself via `tmux switch-client` instead)

set -euo pipefail

no_attach=false
if [ "${1:-}" = "--no-attach" ]; then
  no_attach=true
  shift
fi

projects_root="${DEV_PROJECTS_ROOT:-$HOME/Git}"

pick_dir() {
  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf not found — install it, or run 'dev <directory>' directly." >&2
    exit 1
  fi
  find "$projects_root" -mindepth 1 -maxdepth 2 -type d -name ".git" 2>/dev/null \
    | sed 's|/\.git$||' \
    | fzf --prompt="project> " --height=40% --reverse
}

if [ $# -ge 1 ]; then
  dir="$1"
elif [ -d "$PWD/.git" ]; then
  dir="$PWD"
else
  dir="$(pick_dir)"
  if [ -z "$dir" ]; then
    echo "No project selected." >&2
    exit 1
  fi
fi

session="$(basename "$dir")"
session="${session//[^a-zA-Z0-9_-]/-}"

if tmux has-session -t "$session" 2>/dev/null; then
  if [ "$no_attach" = true ]; then
    exit 0
  fi
  exec tmux attach -t "$session"
fi

tmux new-session -d -s "$session" -n nvim -c "$dir"
tmux send-keys -t "$session:nvim" "nvim -c 'Telescope find_files'" C-m

tmux new-window -t "$session" -n claude -c "$dir"
tmux send-keys -t "$session:claude" "claude" C-m

tmux new-window -t "$session" -n shell -c "$dir"

tmux new-window -t "$session" -n lazygit -c "$dir"
tmux send-keys -t "$session:lazygit" "lazygit" C-m

tmux select-window -t "$session:nvim"

if [ "$no_attach" = true ]; then
  exit 0
fi

exec tmux attach -t "$session"
