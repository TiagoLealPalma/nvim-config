#!/usr/bin/env bash
# Opens (or attaches to) a tmux session with a fixed 3-window layout:
#   1: nvim   2: claude   3: shell
# Usage: dev [directory]
#   - directory given: use it directly
#   - no directory, cwd is already a git repo: use cwd
#   - no directory, cwd isn't a project: fuzzy-pick one from ~/Git via fzf

set -euo pipefail

session="dev"
projects_root="${DEV_PROJECTS_ROOT:-$HOME/Git}"

pick_dir() {
  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf not found — install it, or run 'dev <directory>' directly." >&2
    exit 1
  fi
  find "$projects_root" -mindepth 1 -maxdepth 2 -type d -name ".git" 2>/dev/null \
    | sed 's|/\.git$||' \
    | fzf --prompt="project> " --height=40% --reverse
}

if [ $# -ge 1 ]; then
  dir="$1"
elif [ -d "$PWD/.git" ]; then
  dir="$PWD"
else
  dir="$(pick_dir)"
  if [ -z "$dir" ]; then
    echo "No project selected." >&2
    exit 1
  fi
fi

if tmux has-session -t "$session" 2>/dev/null; then
  exec tmux attach -t "$session"
fi

tmux new-session -d -s "$session" -n nvim -c "$dir"
tmux send-keys -t "$session:nvim" "nvim" C-m

tmux new-window -t "$session" -n claude -c "$dir"
tmux send-keys -t "$session:claude" "claude" C-m

tmux new-window -t "$session" -n shell -c "$dir"

tmux select-window -t "$session:nvim"
exec tmux attach -t "$session"
